<UserControl x:Class="Flow.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viz="clr-namespace:Flow.Visualizer"
             xmlns:local="clr-namespace:Flow.Views"
             xmlns:svc="clr-namespace:Flow.Services">
    <Grid x:Name="Root" Background="Transparent">

        <!-- Empty state -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40"
                    Visibility="{Binding Playback.HasTrack, Converter={StaticResource InverseBoolToVis}}">
            <Image Source="/Assets/Flow.png" Width="88" Height="88" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Flow" Style="{StaticResource PageTitle}" FontSize="34" HorizontalAlignment="Center" Margin="0,20,0,4"/>
            <TextBlock Text="The minimal and beautiful music player" Style="{StaticResource Secondary}" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                <Button Style="{StaticResource AccentPillButton}" Command="{Binding OpenFilesCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Open files"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PillButton}" Command="{Binding AddFolderCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F4;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Add music folder"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PillButton}" Command="{Binding NavigateCommand}" CommandParameter="Library">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Browse library"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="…or drop songs and folders anywhere in this window" Style="{StaticResource Tertiary}"
                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>

        <!-- Player -->
        <Grid x:Name="Player" Visibility="{Binding Playback.HasTrack, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Visualizer style switcher (top-right): click = next style, right-click = previous -->
            <StackPanel x:Name="StyleSwitcher" Grid.Row="0" Panel.ZIndex="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,18,0">
                <Border x:Name="StyleNameBadge" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Center"
                        Margin="0,0,8,0" Padding="12,5" CornerRadius="13" Background="{DynamicResource MenuBrush}"
                        BorderBrush="{DynamicResource MenuStrokeBrush}" BorderThickness="1">
                    <TextBlock x:Name="StyleNameText" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>
                <Button x:Name="StyleButton" Style="{StaticResource IconButton}" Width="36" Height="36"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        ToolTip="Visualizer style (click: next · right-click: previous)"
                        Click="StyleButton_Click" MouseRightButtonUp="StyleButton_RightClick">
                    <Path Data="M0,7 h2.4 v7 h-2.4 z M4.6,2 h2.4 v12 h-2.4 z M9.2,5 h2.4 v9 h-2.4 z M13.8,0 h2.4 v14 h-2.4 z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Width="16" Height="14" Stretch="Uniform"/>
                </Button>
            </StackPanel>

            <!-- Art stage with the visualizer around it -->
            <Grid x:Name="Stage" Grid.Row="0" SizeChanged="Stage_SizeChanged" Margin="0,4,0,0">
                <viz:MusicVisualizer x:Name="Viz"
                                     IsActive="{Binding Playback.IsPlaying}"
                                     VisualStyle="{Binding VisualizerStyle}"
                                     ArtElement="{Binding ElementName=ArtHost}"
                                     BlockColor="{DynamicResource VisualizerColor}"
                                     PeakColor="{DynamicResource VisualizerPeakColor}"/>
                <Grid x:Name="ArtHost" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                      MouseWheel="Art_MouseWheel" Background="Transparent" ToolTip="Scroll to change volume">
                    <!-- BitmapCache: the soft shadow is blurred once, not on every frame around it. -->
                    <Border Margin="10" CornerRadius="16" Background="Black" CacheMode="BitmapCache"
                            Visibility="{Binding Playback.CurrentArt, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="48" ShadowDepth="14" Direction="270" Opacity="0.5"/>
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="16" Background="{DynamicResource SurfaceStrongBrush}">
                        <TextBlock Text="&#xEC4F;" Style="{StaticResource Glyph}" FontSize="72" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Border>
                    <Border x:Name="ArtImage" CornerRadius="16" BorderBrush="{DynamicResource ArtFrameStrokeBrush}" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Playback.CurrentArt}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
            </Grid>

            <!-- Track info + transport -->
            <StackPanel x:Name="ControlsPanel" Grid.Row="1" HorizontalAlignment="Center" Width="560" Margin="24,6,24,26">
                <!-- Song info + timeline: an LCD panel in Brushed Metal, invisible in the other themes -->
                <Border svc:LcdScope.IsLcd="True" Background="{DynamicResource NowPlayingLcdBrush}" BorderBrush="{DynamicResource NowPlayingLcdStrokeBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="{DynamicResource NowPlayingLcdPadding}" Margin="0,0,0,6"><StackPanel>
                <TextBlock Text="{Binding Playback.CurrentTrack.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="25"
                           FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <!-- Artist(s) · Album, each a link into the Library -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0" TextElement.FontSize="14">
                    <ItemsControl ItemsSource="{Binding Playback.CurrentTrack.ArtistList}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=", " FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding RelativeSource={RelativeSource PreviousData}, Converter={StaticResource BoolToVis}}"/>
                                    <Button Style="{StaticResource LinkButton}" Content="{Binding}" FontSize="14" ToolTip="Show this artist"
                                            Command="{Binding DataContext.ShowArtistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="  ·  " FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                               Visibility="{Binding Playback.CurrentTrack.Album, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource LinkButton}" Content="{Binding Playback.CurrentTrack.Album}" FontSize="14"
                            ToolTip="Show this album" MaxWidth="320"
                            Visibility="{Binding Playback.CurrentTrack.Album, Converter={StaticResource BoolToVis}}"
                            Command="{Binding ShowAlbumCommand}" CommandParameter="{Binding Playback.CurrentTrack}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"
                            Visibility="{Binding Playback.CurrentIsSpotify, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SpotifyGreenBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding Playback.PlayingOnText}" Style="{StaticResource Tertiary}"/>
                </StackPanel>
                <Border Height="14"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Value, ElementName=Timeline, Converter={StaticResource SecondsToTime}}"
                               Style="{StaticResource Tertiary}" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider x:Name="Timeline" Grid.Column="1" Style="{StaticResource FlowSlider}" Margin="12,0"
                            Minimum="0" Maximum="{Binding Playback.DurationSeconds}"
                            Value="{Binding Playback.PositionSeconds, Mode=OneWay}"
                            PreviewMouseLeftButtonDown="Timeline_PreviewMouseDown"
                            PreviewMouseLeftButtonUp="Timeline_PreviewMouseUp"
                            Thumb.DragStarted="Timeline_DragStarted"
                            Thumb.DragCompleted="Timeline_DragCompleted"/>
                    <TextBlock Grid.Column="2" Text="{Binding Playback.DurationSeconds, Converter={StaticResource SecondsToTime}}"
                               Style="{StaticResource Tertiary}" VerticalAlignment="Center"/>
                </Grid>
                </StackPanel></Border>

                <!-- Main transport -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE8B1;" ToolTip="Shuffle  (Ctrl+S)"
                                  IsChecked="{Binding Playback.Shuffle}" Margin="0,0,14,0"/>
                    <Button x:Name="PrevButton" Style="{StaticResource TransportButton}" Content="&#xE892;" FontSize="20" Width="48" Height="48"
                            ToolTip="Previous · hold to rewind" Click="PrevButton_Click"
                            PreviewMouseLeftButtonDown="Scrub_MouseDown" PreviewMouseLeftButtonUp="Scrub_MouseUp" MouseLeave="Scrub_MouseLeave"/>
                    <Button Style="{StaticResource PlayButton}" Margin="16,0" Command="{Binding PlayPauseCommand}"
                            ToolTip="Play / Pause  (Space)"
                            Content="{Binding Playback.IsPlaying, Converter={StaticResource BoolToText}, ConverterParameter='&#xE769;|&#xE768;'}"/>
                    <Button x:Name="NextButton" Style="{StaticResource TransportButton}" Content="&#xE893;" FontSize="20" Width="48" Height="48"
                            ToolTip="Next · hold to fast-forward" Click="NextButton_Click"
                            PreviewMouseLeftButtonDown="Scrub_MouseDown" PreviewMouseLeftButtonUp="Scrub_MouseUp" MouseLeave="Scrub_MouseLeave"/>
                    <ToggleButton Style="{StaticResource IconToggle}" Margin="14,0,0,0" ToolTip="Repeat  (Ctrl+R)"
                                  Content="{Binding Playback.Repeat, Converter={StaticResource RepeatGlyph}}"
                                  IsChecked="{Binding Playback.Repeat, Mode=OneWay, Converter={StaticResource RepeatActive}}"
                                  Command="{Binding RepeatCommand}"/>
                </StackPanel>

                <!-- Secondary row -->
                <StackPanel x:Name="SecondaryRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <ToggleButton Style="{StaticResource IconToggle}" Width="36" Height="34" FontSize="14" ToolTip="Favorite"
                                  IsChecked="{Binding Playback.CurrentTrack.IsFavorite, Mode=OneWay}"
                                  Content="{Binding Playback.CurrentTrack.IsFavorite, Converter={StaticResource BoolToText}, ConverterParameter='&#xEB52;|&#xE006;'}"
                                  Command="{Binding FavoriteCommand}"/>
                    <ToggleButton Style="{StaticResource IconToggle}" Width="36" Height="34" FontSize="14" Content="&#xE90B;"
                                  ToolTip="Up Next" IsChecked="{Binding IsQueueOpen}" Margin="4,0,0,0"/>
                    <Button Style="{StaticResource IconButton}" Width="36" Height="34" FontSize="14" Content="&#xE93C;"
                            Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="Go to album" Margin="4,0,0,0"
                            Command="{Binding ShowAlbumCommand}" CommandParameter="{Binding Playback.CurrentTrack}"/>
                    <Button Style="{StaticResource IconButton}" Width="36" Height="34" FontSize="14" Content="&#xE772;" Margin="4,0,14,0"
                            Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="Play on another device" Click="Devices_Click"/>
                    <Button Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="14"
                            Foreground="{DynamicResource TextSecondaryBrush}" Command="{Binding MuteCommand}" ToolTip="Mute  (M)">
                        <Button.Content>
                            <MultiBinding Converter="{StaticResource VolumeGlyph}">
                                <Binding Path="Playback.Volume"/>
                                <Binding Path="Playback.IsMuted"/>
                            </MultiBinding>
                        </Button.Content>
                    </Button>
                    <Slider Style="{StaticResource FlowSlider}" Width="120" Minimum="0" Maximum="1" Margin="6,0,0,0"
                            VerticalAlignment="Center" SmallChange="0.02" LargeChange="0.1"
                            Value="{Binding Playback.Volume}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Up Next panel -->
        <Border x:Name="QueuePanel" HorizontalAlignment="Right" Width="350" Margin="0,4,16,16" CornerRadius="12"
                Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                Visibility="{Binding IsQueueOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="10,6,2,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="11"
                            Content="&#xE8BB;" ToolTip="Close" Command="{Binding ToggleQueueCommand}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="13"
                            Content="&#xE74D;" ToolTip="Clear queue" Command="{Binding ClearQueueCommand}" Margin="0,0,4,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Up Next" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Tertiary}" Text="{Binding Playback.Queue.Count, StringFormat={}{0} tracks · drag to reorder}"/>
                    </StackPanel>
                </DockPanel>
                <ListBox x:Name="QueueList" Grid.Row="1" Style="{StaticResource FlowList}" ItemsSource="{Binding Playback.Queue}"
                         MouseDoubleClick="QueueList_DoubleClick" ContextMenuOpening="QueueList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu/>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <local:NowPlayingIndicator HorizontalAlignment="Left"
                                           Visibility="{Binding IsPlayingNow, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="T" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                    <TextBlock Text="{Binding DisplayArtist}" Style="{StaticResource Tertiary}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Tertiary}"
                                           VerticalAlignment="Center" Margin="8,0"/>
                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10"
                                        Content="&#xE711;" ToolTip="Remove" Click="QueueRemove_Click"
                                        Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPlayingNow}" Value="True">
                                    <Setter TargetName="T" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <!-- Pop out the mini player (floats above all windows) -->
        <Button Style="{StaticResource IconButton}" Width="38" Height="38" FontSize="15" Content="&#xE8A7;"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18"
                Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="Pop out mini player" Click="PopOut_Click"/>
    </Grid>
</UserControl>
