<UserControl x:Class="Flow.Views.PlaylistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Flow.Views">
    <Grid x:Name="Root" DataContext="{Binding Playlists}" Margin="28,0,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Playlist navigation -->
        <DockPanel Margin="0,0,24,0" Width="226">
            <DockPanel.LayoutTransform>
                <ScaleTransform ScaleX="{Binding TextScale}" ScaleY="{Binding TextScale}"/>
            </DockPanel.LayoutTransform>
            <TextBlock DockPanel.Dock="Top" Text="Playlists" Style="{StaticResource PageTitle}" Margin="0,0,0,14"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Style="{StaticResource PillButton}" Click="NewPlaylist_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="New"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PillButton}" Click="Import_Click" ToolTip="Import an .m3u / .m3u8 playlist">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="Import"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <ListBox x:Name="EntryList" Style="{StaticResource FlowList}" ItemContainerStyle="{StaticResource NavItem}"
                     ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Width="22"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Selected playlist -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,4,12,16" LastChildFill="False">
                <DockPanel.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding TextScale}" ScaleY="{Binding TextScale}"/>
                </DockPanel.LayoutTransform>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding Selected.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding InfoText}" Style="{StaticResource Secondary}" Margin="0,2,0,14"/>
                </StackPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource AccentPillButton}" Command="{Binding PlayCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="Play"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource PillButton}" Command="{Binding ShuffleCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B1;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock Text="Shuffle"/>
                    </StackPanel>
                </Button>
                <local:TextSizePicker DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" GroupName="PlaylistTextSize"
                                      Value="{Binding TextSize}"/>
                <local:ArtSizePicker DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" GroupName="PlaylistArtSize"
                                     Value="{Binding ArtSize}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="14" Content="&#xE74D;"
                        ToolTip="Delete playlist" Click="Delete_Click"
                        Visibility="{Binding IsUserPlaylist, Converter={StaticResource BoolToVis}}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="14" Content="&#xE8AC;"
                        ToolTip="Rename" Click="Rename_Click"
                        Visibility="{Binding IsUserPlaylist, Converter={StaticResource BoolToVis}}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="14" Content="&#xEDE1;"
                        ToolTip="Export as .m3u8" Click="Export_Click"/>
            </DockPanel>

            <ListBox x:Name="TrackList" Grid.Row="1" Style="{StaticResource FlowList}" SelectionMode="Extended"
                     ItemsSource="{Binding Tracks}" MouseDoubleClick="TrackList_DoubleClick"
                     ContextMenuOpening="TrackList_ContextMenuOpening" KeyDown="TrackList_KeyDown">
                <ListBox.ContextMenu>
                    <ContextMenu/>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Album cover (size follows the artwork size picker) -->
                            <Grid x:Name="NoteBox" Margin="0,0,14,0" VerticalAlignment="Center"
                                  Width="{Binding DataContext.RowThumb, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  Height="{Binding DataContext.RowThumb, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                <Border CornerRadius="5" Background="{DynamicResource SurfaceStrongBrush}">
                                    <TextBlock Text="&#xEC4F;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Border>
                                <Border CornerRadius="5">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumb, IsAsync=True}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <local:NowPlayingIndicator x:Name="PlayingGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,0,14,0" Visibility="Collapsed"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding DataContext.TextScale, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    ScaleY="{Binding DataContext.TextScale, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                </StackPanel.LayoutTransform>
                                <TextBlock x:Name="T" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DisplayArtist}" Style="{StaticResource Tertiary}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding DisplayAlbum}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,16,0"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding DataContext.TextScale, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    ScaleY="{Binding DataContext.TextScale, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" Style="{StaticResource Tertiary}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding DataContext.TextScale, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    ScaleY="{Binding DataContext.TextScale, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPlayingNow}" Value="True">
                                <Setter TargetName="T" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="NoteBox" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="PlayingGlyph" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Right-click any song and choose “Add to playlist”."
                       Visibility="{Binding Tracks.Count, Converter={StaticResource InverseBoolToVis}}"/>
        </Grid>
    </Grid>
</UserControl>
