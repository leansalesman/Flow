<UserControl x:Class="Flow.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Flow.Views">
    <UserControl.Resources>
        <Style x:Key="AlbumTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FlowFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GenreChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FlowFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="12,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Album tile on the artist page -->
        <DataTemplate x:Key="ArtistAlbumTile">
            <Button x:Name="Tile" Style="{StaticResource AlbumTile}" Width="150" Margin="0,0,18,18"
                    Command="{Binding DataContext.OpenAlbumCommand, ElementName=Root}" CommandParameter="{Binding}"
                    ToolTip="{Binding Title}">
                <StackPanel>
                    <Grid Width="150" Height="150">
                        <Border CornerRadius="8" Background="{DynamicResource SurfaceStrongBrush}">
                            <TextBlock Text="&#xEC4F;" Style="{StaticResource Glyph}" FontSize="32" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </Border>
                        <Border CornerRadius="8">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumb, IsAsync=True}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Shade" CornerRadius="8" Background="#38000000" Opacity="0"/>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="2,8,2,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding InfoLine}" Style="{StaticResource Tertiary}" Margin="2,2,2,0"/>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Shade" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AlbumTileTemplate">
            <Button x:Name="Tile" Style="{StaticResource AlbumTile}" Margin="0,0,22,0"
                    Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    Command="{Binding DataContext.OpenAlbumCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    ContextMenuOpening="Album_ContextMenuOpening">
                <Button.ContextMenu>
                    <ContextMenu/>
                </Button.ContextMenu>
                <StackPanel>
                    <Grid x:Name="ArtBox" Height="{Binding Width, ElementName=Tile}" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ArtScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border CornerRadius="10" Background="{DynamicResource SurfaceStrongBrush}">
                            <TextBlock Text="&#xEC4F;" Style="{StaticResource Glyph}" FontSize="40" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </Border>
                        <Border CornerRadius="10">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumb, IsAsync=True}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Shade" CornerRadius="10" Background="#38000000" Opacity="0"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" CornerRadius="9" Padding="7,3"
                                Background="#CC111111" ToolTip="From your Spotify library"
                                Visibility="{Binding IsSpotify, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SpotifyGreenBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Spotify" Foreground="White" FontSize="10" FontWeight="SemiBold" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="PlayOverlay" Style="{StaticResource PlayButton}" Width="44" Height="44" FontSize="15"
                                Content="&#xE768;" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                                Opacity="0" Click="TilePlay_Click" ToolTip="Play album"/>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="2,10,2,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Artist}" Style="{StaticResource Tertiary}" Margin="2,2,2,0"/>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Shade" Property="Opacity" Value="1"/>
                    <Setter TargetName="PlayOverlay" Property="Opacity" Value="1"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArtScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="ArtScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArtScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="ArtScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" DataContext="{Binding Library}" Margin="28,0,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Everything behind the album detail panel; blurred + dimmed while an album is open -->
        <Grid x:Name="LibraryContent" Grid.RowSpan="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Library" Style="{StaticResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Secondary}"/>
                <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Tertiary}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,12,14" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource AccentPillButton}" Command="{Binding PlayAllCommand}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Play"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource PillButton}" Command="{Binding ShuffleAllCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B1;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Shuffle"/>
                </StackPanel>
            </Button>

            <!-- Source: everything / local files / Spotify -->
            <Border DockPanel.Dock="Left" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Margin="14,0,0,0"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentRadio}" Content="All" GroupName="LibSource" Padding="12,5"
                                 IsChecked="{Binding Source, Converter={StaticResource EqualsConv}, ConverterParameter=All}"/>
                    <RadioButton Style="{StaticResource SegmentRadio}" GroupName="LibSource" Padding="12,5" ToolTip="Files on this PC"
                                 IsChecked="{Binding Source, Converter={StaticResource EqualsConv}, ConverterParameter=Local}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F8;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Local"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SegmentRadio}" GroupName="LibSource" Padding="12,5" ToolTip="Your Spotify library"
                                 IsChecked="{Binding Source, Converter={StaticResource EqualsConv}, ConverterParameter=Spotify}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SpotifyGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Spotify"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Margin="8,0,0,0"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentRadio}" Padding="10,6" ToolTip="Album shelves"
                                 IsChecked="{Binding IsGridView}">
                        <TextBlock Text="&#xF0E2;" Style="{StaticResource Glyph}" FontSize="14"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SegmentRadio}" Padding="10,6" ToolTip="Track list"
                                 IsChecked="{Binding IsGridView, Converter={StaticResource EqualsConv}, ConverterParameter=False, Mode=OneWay}"
                                 Command="{Binding ShowTableCommand}">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Glyph}" FontSize="14"/>
                    </RadioButton>
                </StackPanel>
            </Border>
            <local:ArtSizePicker DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" GroupName="LibraryArtSize"
                                 Value="{Binding ArtSize}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="13" Margin="4,0,0,0"
                    Command="{Binding ToggleSortDirectionCommand}"
                    ToolTip="{Binding SortDescending, Converter={StaticResource BoolToText}, ConverterParameter=Descending|Ascending}"
                    Content="{Binding SortDescending, Converter={StaticResource BoolToText}, ConverterParameter='&#xE74B;|&#xE74A;'}"/>
            <Button x:Name="SortButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="SortButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8CB;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding SortLabel}"/>
                    <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="9" Margin="8,1,0,0"/>
                </StackPanel>
            </Button>
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Style="{StaticResource SearchBox}" Width="240" Tag="Search your music"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <!-- Genre filter chips: toggle one or more; Play/Shuffle then use only those genres -->
        <DockPanel Grid.Row="2" Margin="0,0,12,14"
                   Visibility="{Binding GenreChips.Count, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="12,5" Margin="10,0,0,0"
                    VerticalAlignment="Center" Command="{Binding ClearGenresCommand}"
                    Visibility="{Binding HasGenreFilter, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10" Margin="0,0,7,0"/>
                    <TextBlock Text="Deselect" FontSize="12"/>
                </StackPanel>
            </Button>
            <ScrollViewer x:Name="GenreScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="GenreScroller_MouseWheel">
                <ItemsControl ItemsSource="{Binding GenreChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource GenreChip}" IsChecked="{Binding IsSelected}" Margin="0,0,6,0"
                                          ToolTip="{Binding Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                    <TextBlock Text="{Binding CountText}" FontSize="11" Margin="6,0,0,0" Opacity="0.6" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Empty library -->
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,80"
                    Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" FontSize="48" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Text="Your shelves are empty" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
            <TextBlock Text="Add a folder of music and Flow will keep it in sync automatically." Style="{StaticResource Secondary}" HorizontalAlignment="Center"/>
            <Button Style="{StaticResource AccentPillButton}" Content="Add music folder" HorizontalAlignment="Center" Margin="0,18,0,0"
                    Click="AddFolder_Click"/>
        </StackPanel>

        <!-- Album shelves -->
        <ListBox x:Name="Shelves" Grid.Row="3" Style="{StaticResource FlowList}" ItemContainerStyle="{StaticResource PlainItem}"
                 ItemsSource="{Binding Rows}" SizeChanged="Shelves_SizeChanged" Padding="0,4,0,24"
                 Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,28">
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource AlbumTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- the shelf -->
                        <Border Height="3" CornerRadius="1.5" Margin="-6,12,14,0" Background="{DynamicResource ShelfBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Track table -->
        <DataGrid x:Name="Table" Grid.Row="3" ItemsSource="{Binding Tracks}" Margin="0,0,0,8" RowHeight="{Binding TableRowHeight}"
                  Visibility="{Binding IsGridView, Converter={StaticResource InverseBoolToVis}}"
                  Sorting="Table_Sorting" MouseDoubleClick="Table_DoubleClick" ContextMenuOpening="Table_ContextMenuOpening"
                  PreviewKeyDown="Table_PreviewKeyDown">
            <DataGrid.ContextMenu>
                <ContextMenu/>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="34" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="Fav" Text="&#xEB52;" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                            <Setter Property="Visibility" Value="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlayingNow}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <local:NowPlayingIndicator Visibility="{Binding IsPlayingNow, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Album cover (size follows the artwork size picker); click to spotlight the album -->
                <DataGridTemplateColumn Width="SizeToCells" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button ToolTip="Show this album" Cursor="Hand" Focusable="False"
                                    Command="{Binding DataContext.OpenAlbumOfTrackCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Button.Template>
                                <!-- Cover lives in the button's content (not its template) so the image binding resolves cleanly -->
                                <Grid Width="{Binding DataContext.TableThumb, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      Height="{Binding DataContext.TableThumb, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                    <Border CornerRadius="4" Background="{DynamicResource SurfaceStrongBrush}">
                                        <TextBlock Text="&#xEC4F;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Border>
                                    <Border CornerRadius="4">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumb, IsAsync=True}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" SortMemberPath="TrackName" Width="2.2*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTemplateColumn Header="Artist" SortMemberPath="ArtistName" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- One link per artist: "A$AP Rocky, Tokischa" -->
                            <ItemsControl ItemsSource="{Binding ArtistList}" VerticalAlignment="Center" ClipToBounds="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text=", " Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding RelativeSource={RelativeSource PreviousData}, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource LinkButton}" Content="{Binding}" ToolTip="Show this artist"
                                                    Command="{Binding DataContext.OpenArtistCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Album" SortMemberPath="AlbumName" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkButton}" Content="{Binding DisplayAlbum}" ToolTip="Show this album"
                                    Command="{Binding DataContext.OpenAlbumOfTrackCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Length" Binding="{Binding DurationText}" SortMemberPath="TrackLength" Width="80" ElementStyle="{StaticResource CellTextDim}"/>
                <DataGridTextColumn Header="Year" Binding="{Binding YearText}" SortMemberPath="Year" Width="70" ElementStyle="{StaticResource CellTextDim}"/>
                <DataGridTemplateColumn Header="Genre" SortMemberPath="Genre" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkButton}" Content="{Binding Genre}" ToolTip="Show only this genre"
                                    Command="{Binding DataContext.FilterGenreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Source" Width="90" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource SpotifyGreenBrush}" Margin="0,0,6,0"
                                         VerticalAlignment="Center" Visibility="{Binding IsSpotify, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource CellTextDim}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Plays" Binding="{Binding PlayCount}" SortMemberPath="PlayCount" Width="70" ElementStyle="{StaticResource CellTextDim}"/>
                <DataGridTextColumn Header="Added" Binding="{Binding DateAddedText}" SortMemberPath="DateAdded" Width="100" ElementStyle="{StaticResource CellTextDim}"/>
            </DataGrid.Columns>
        </DataGrid>

        </Grid>

        <!-- Artist page -->
        <Border x:Name="ArtistOverlay" Grid.Row="0" Grid.RowSpan="4" Margin="-12,0,0,16" CornerRadius="14"
                Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                Visibility="{Binding ShowArtistOverlay, Converter={StaticResource BoolToVis}}"
                IsVisibleChanged="Overlay_IsVisibleChanged">
            <Grid>
                <local:TextSizePicker HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0" Panel.ZIndex="1" GroupName="ArtistTextSize" Value="{Binding TextSize}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,20,16">
                <StackPanel>
                    <StackPanel.LayoutTransform><ScaleTransform ScaleX="{Binding TextScale}" ScaleY="{Binding TextScale}"/></StackPanel.LayoutTransform>
                    <Button Style="{StaticResource PillButton}" HorizontalAlignment="Left" Command="{Binding CloseArtistCommand}" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Back"/>
                        </StackPanel>
                    </Button>

                    <!-- Header: picture, name, stats, play -->
                    <DockPanel Margin="0,0,0,26">
                        <Grid DockPanel.Dock="Left" Width="150" Height="150" Margin="0,0,28,0">
                            <Ellipse Fill="{DynamicResource SurfaceStrongBrush}"/>
                            <TextBlock Text="{Binding SelectedArtist.Initial}" FontSize="56" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding SelectedArtist.Thumb, IsAsync=True}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ARTIST" Style="{StaticResource Tertiary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedArtist.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="36"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,2"/>
                            <TextBlock Text="{Binding SelectedArtist.InfoLine}" Style="{StaticResource Secondary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource AccentPillButton}" Command="{Binding PlayArtistCommand}" CommandParameter="{Binding SelectedArtist}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Play"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PillButton}" Command="{Binding ShuffleArtistCommand}" CommandParameter="{Binding SelectedArtist}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B1;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Shuffle"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- Albums -->
                    <TextBlock Text="Albums" Style="{StaticResource SectionTitle}"
                               Visibility="{Binding SelectedArtist.HasAlbums, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding SelectedArtist.Albums}" ItemTemplate="{StaticResource ArtistAlbumTile}" Margin="0,0,0,18"
                                  Visibility="{Binding SelectedArtist.HasAlbums, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Appears on -->
                    <TextBlock Text="Appears on" Style="{StaticResource SectionTitle}"
                               Visibility="{Binding SelectedArtist.HasAppearsOn, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding SelectedArtist.AppearsOn}" ItemTemplate="{StaticResource ArtistAlbumTile}" Margin="0,0,0,18"
                                  Visibility="{Binding SelectedArtist.HasAppearsOn, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Songs -->
                    <TextBlock Text="Songs" Style="{StaticResource SectionTitle}"/>
                    <ListBox x:Name="ArtistTracks" ItemsSource="{Binding SelectedArtist.Tracks}" SelectionMode="Extended"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                             ItemContainerStyle="{StaticResource RowItem}"
                             MouseDoubleClick="ArtistTracks_DoubleClick" ContextMenuOpening="ArtistTracks_ContextMenuOpening">
                        <ListBox.Template>
                            <!-- No inner scrollbar: the whole page scrolls -->
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter/>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ContextMenu>
                            <ContextMenu/>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <local:NowPlayingIndicator x:Name="Playing" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                    <TextBlock x:Name="T" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="{Binding DisplayAlbum}" Margin="0,0,16,0"
                                            ToolTip="Show this album"
                                            Command="{Binding DataContext.OpenAlbumOfTrackCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" Style="{StaticResource Tertiary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPlayingNow}" Value="True">
                                        <Setter TargetName="T" Property="FontWeight" Value="SemiBold"/>
                                        <Setter TargetName="Playing" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Border>

        <!-- Album detail -->
        <Border x:Name="AlbumOverlay" Grid.Row="0" Grid.RowSpan="4" Margin="-12,0,0,16" CornerRadius="14"
                Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                Visibility="{Binding IsAlbumOpen, Converter={StaticResource BoolToVis}}"
                IsVisibleChanged="Overlay_IsVisibleChanged">
            <Grid>
                <local:TextSizePicker HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0" Panel.ZIndex="1" GroupName="AlbumTextSize" Value="{Binding TextSize}"/>
            <!-- Text size: the whole spotlight scales (title, details, buttons, cover, track list) -->
            <Grid Margin="28,20,16,16">
                <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding TextScale}" ScaleY="{Binding TextScale}"/></Grid.LayoutTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Width="260" Margin="0,0,32,0">
                    <Button Style="{StaticResource PillButton}" HorizontalAlignment="Left" Command="{Binding CloseAlbumCommand}" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Back"/>
                        </StackPanel>
                    </Button>
                    <Grid Width="260" Height="260">
                        <Border Margin="8" CornerRadius="12" Background="Black">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.45"/>
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="12" Background="{DynamicResource SurfaceStrongBrush}">
                            <TextBlock Text="&#xEC4F;" Style="{StaticResource Glyph}" FontSize="56" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </Border>
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding SelectedAlbum.LargeArt, IsAsync=True}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding SelectedAlbum.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,18,0,2"/>
                    <Button Style="{StaticResource LinkButton}" Content="{Binding SelectedAlbum.Artist}" FontSize="14"
                            ToolTip="Show this artist" Command="{Binding OpenArtistCommand}" CommandParameter="{Binding SelectedAlbum.Artist}"/>
                    <TextBlock Text="{Binding SelectedAlbum.InfoLine}" Style="{StaticResource Tertiary}" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource AccentPillButton}" Command="{Binding PlayAlbumCommand}" CommandParameter="{Binding SelectedAlbum}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Play"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Command="{Binding ShuffleAlbumCommand}" CommandParameter="{Binding SelectedAlbum}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B1;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Shuffle"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="AlbumTracks" Grid.Column="1" Style="{StaticResource FlowList}" SelectionMode="Extended"
                         ItemsSource="{Binding SelectedAlbum.Tracks}" Margin="0,52,0,0"
                         MouseDoubleClick="AlbumTracks_DoubleClick" ContextMenuOpening="AlbumTracks_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu/>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Num" Text="{Binding TrackNumber}" Style="{StaticResource Tertiary}" VerticalAlignment="Center"/>
                                <local:NowPlayingIndicator x:Name="Playing" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="T" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xEB52;" Style="{StaticResource Glyph}" FontSize="11" Margin="8,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" Style="{StaticResource Tertiary}" VerticalAlignment="Center" Margin="8,0"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPlayingNow}" Value="True">
                                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter TargetName="T" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="Num" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Playing" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
