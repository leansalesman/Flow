<UserControl x:Class="Flow.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  DataContext="{Binding Settings}" Padding="24,0,24,20">
        <!-- Stretch + MaxWidth: fills narrow windows, and centers at a comfortable reading width in wide ones -->
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,18"/>

            <!-- Music folders -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource PillButton}" Command="{Binding RescanCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Rescan"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentPillButton}" Command="{Binding AddFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Add folder"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Music folders" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Text="Flow watches these folders and keeps your library in sync automatically."
                                       Style="{StaticResource Tertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Folders}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,6" Margin="0,3">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="11"
                                                Content="&#xE711;" ToolTip="Remove folder"
                                                Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="15" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No folders yet — add one to fill your shelves." Style="{StaticResource Secondary}" Margin="0,8,0,0"
                               Visibility="{Binding Folders.Count, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Spotify -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource PillButton}" Command="{Binding SyncSpotifyCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding Spotify.IsConnected, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Sync now"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillButton}" Command="{Binding DisconnectSpotifyCommand}" Content="Disconnect"
                                    Visibility="{Binding Spotify.IsConnected, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource AccentPillButton}" Command="{Binding ConnectSpotifyCommand}"
                                    Visibility="{Binding Spotify.IsConnected, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource SpotifyGreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Connect Spotify"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource SpotifyGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Spotify" Style="{StaticResource SectionTitle}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Spotify.StatusText}" Style="{StaticResource Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- One-time setup (shown until connected) -->
                    <StackPanel Visibility="{Binding Spotify.IsConnected, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,10" TextTrimming="None"
                                   Text="One-time setup (about 2 minutes). Spotify requires each personal app to have its own free developer key:"/>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" LineHeight="22">
                            <Run Text="1.  Open the Spotify Developer Dashboard, sign in and choose"/> <Run Text="Create app" FontWeight="SemiBold"/><Run Text="."/>
                            <LineBreak/>
                            <Run Text="2.  Any name/description. Add the Redirect URI below, tick"/> <Run Text="Web API" FontWeight="SemiBold"/><Run Text=", and save."/>
                            <LineBreak/>
                            <Run Text="3.  Copy the app's"/> <Run Text="Client ID" FontWeight="SemiBold"/> <Run Text="into the box below and press Connect Spotify."/>
                        </TextBlock>
                        <Button Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="0,12,0,14"
                                Command="{Binding OpenSpotifyDashboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Open Spotify Developer Dashboard"/>
                            </StackPanel>
                        </Button>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Redirect URI" Width="110" Style="{StaticResource RowLabel}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="13"
                                    Content="&#xE8C8;" ToolTip="Copy" Command="{Binding CopyRedirectCommand}" Margin="6,0,0,0"/>
                            <TextBox Style="{StaticResource PlainTextBox}" IsReadOnly="True" Text="{Binding SpotifyRedirectUri, Mode=OneWay}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Client ID" Width="110" Style="{StaticResource RowLabel}"/>
                            <TextBox Style="{StaticResource PlainTextBox}" Margin="0,0,40,0"
                                     Text="{Binding SpotifyClientId, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Import options -->
                    <TextBlock Text="Import into Flow" Style="{StaticResource RowLabel}" FontWeight="SemiBold" Margin="0,16,0,10"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SpotifyImportLiked}" Margin="0,0,0,10">
                        <TextBlock Text="Liked Songs" Style="{StaticResource RowLabel}"/>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SpotifyImportAlbums}" Margin="0,0,0,10">
                        <TextBlock Text="Saved albums" Style="{StaticResource RowLabel}"/>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SpotifyImportPlaylists}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Playlists" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="Spotify only shares the songs of playlists you own or collaborate on" Style="{StaticResource Tertiary}"/>
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Tertiary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                               Text="Spotify songs play through the Spotify app on this PC (or any Spotify Connect device) and require Premium. Flow controls playback, keeps your queue and shows the visualizer."/>
                </StackPanel>
            </Border>

            <!-- Equalizer -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EqEnabled}">
                        <StackPanel>
                            <TextBlock Text="Equalizer" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Style="{StaticResource Tertiary}" Text="{Binding EqPreset, StringFormat=Preset: {0}}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <ItemsControl ItemsSource="{Binding Presets}" Margin="0,14,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PillButton}" Content="{Binding}" Padding="12,5" Margin="0,0,6,6" FontSize="12"
                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding EqBands}" Margin="0,8,0,0" IsEnabled="{Binding EqEnabled}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Gain, Converter={StaticResource DbFormat}}" Style="{StaticResource Tertiary}"
                                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <Slider Style="{StaticResource EqSlider}" Height="150" HorizontalAlignment="Center"
                                            Value="{Binding Gain}"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Tertiary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Playback -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Playback" Style="{StaticResource SectionTitle}"/>
                    <DockPanel Margin="0,4,0,14">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CrossfadeText}" Width="44" TextAlignment="Right"
                                   Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Left" Width="230">
                            <TextBlock Text="Crossfade" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="Blend the end of a song into the next" Style="{StaticResource Tertiary}"/>
                        </StackPanel>
                        <Slider Style="{StaticResource FlowSlider}" Minimum="0" Maximum="12" Margin="12,0"
                                VerticalAlignment="Center" Value="{Binding CrossfadeSeconds}"/>
                    </DockPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Gapless}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Gapless playback" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="No silence between tracks — perfect for live albums and mixes" Style="{StaticResource Tertiary}"/>
                        </StackPanel>
                    </CheckBox>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentRadio}" Content="Off" GroupName="Rg"
                                             IsChecked="{Binding ReplayGain, Converter={StaticResource EqualsConv}, ConverterParameter=Off}"/>
                                <RadioButton Style="{StaticResource SegmentRadio}" Content="Track" GroupName="Rg"
                                             IsChecked="{Binding ReplayGain, Converter={StaticResource EqualsConv}, ConverterParameter=Track}"/>
                                <RadioButton Style="{StaticResource SegmentRadio}" Content="Album" GroupName="Rg"
                                             IsChecked="{Binding ReplayGain, Converter={StaticResource EqualsConv}, ConverterParameter=Album}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="ReplayGain" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="Even out loudness using ReplayGain tags" Style="{StaticResource Tertiary}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Window & system -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Window &amp; system" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FadeChromeWhilePlaying}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Fade controls while playing" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="The side rail and title bar fade away when the mouse is still" Style="{StaticResource Tertiary}"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Keep playing in the system tray" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="Closing or minimizing Flow hides it to the notification area" Style="{StaticResource Tertiary}"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ResumeOnStart}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Resume where I left off" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="Restore the queue and position when Flow starts" Style="{StaticResource Tertiary}"/>
                        </StackPanel>
                    </CheckBox>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Command="{Binding ToggleOpenWithCommand}"
                                Content="{Binding IsOpenWithRegistered, Converter={StaticResource BoolToText}, ConverterParameter=Remove|Add to Open with}"/>
                        <StackPanel>
                            <TextBlock Text="“Open with” menu" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="Show Flow when you right-click audio files in File Explorer (current user only)" Style="{StaticResource Tertiary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/Flow.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Flow — the minimal and beautiful music player" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Author}" Style="{StaticResource Secondary}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Version}" Style="{StaticResource Tertiary}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Tertiary}" TextWrapping="Wrap" Margin="0,14,0,0"
                               Text="{Binding SupportedFormats, StringFormat=Formats: {0}}"/>
                    <TextBlock Style="{StaticResource Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Shortcuts: Space play/pause · ←/→ seek · Ctrl+←/→ previous/next · ↑/↓ volume · M mute · Ctrl+S shuffle · Ctrl+R repeat · Ctrl+F search · Ctrl+L library · Ctrl+O open · hold ⏮/⏭ to scrub"/>
                    <Button Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                            Command="{Binding OpenDataFolderCommand}" Content="Open data folder"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
