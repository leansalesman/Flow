<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Flow</AssemblyName>
    <RootNamespace>Flow</RootNamespace>
    <Product>Flow</Product>
    <AssemblyTitle>Flow</AssemblyTitle>
    <Description>Flow - the minimal and beautiful music player</Description>
    <Authors>Joseph Martinez</Authors>
    <Company>Joseph Martinez</Company>
    <Copyright>© 2026 Joseph Martinez</Copyright>
    <Version>1.8.13</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\Flow.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Windows 11, 64-bit -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Uncompressed: a compressed bundle unpacks the whole runtime into RAM at startup (~60 MB private,
         ~130 MB working set measured). Uncompressed files are mapped from disk on demand instead. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- Memory-lean runtime settings for a desktop player -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.OggFile" Version="1.0.7" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />  </ItemGroup>

  <ItemGroup>
    <!-- Prefer compacting the heap over growing it (0 = default, 9 = most aggressive). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Flow.ico" />
    <Resource Include="Assets\Flow.png" />
  </ItemGroup>

  <!-- Optional built-in Spotify playback: librespot.exe (built by tools\build-librespot.ps1, not in git) is
       copied next to Flow.exe, outside the single-file bundle. Builds without it are unaffected. -->
  <ItemGroup Condition="Exists('..\..\tools\librespot\librespot.exe')">
    <None Include="..\..\tools\librespot\librespot.exe" Link="librespot.exe"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <!-- Publishing would otherwise pack it inside the single-file Flow.exe; it has to sit next to it instead. -->
  <Target Name="CopyLibrespotBesideFlow" AfterTargets="Publish" Condition="Exists('..\..\tools\librespot\librespot.exe')">
    <Copy SourceFiles="..\..\tools\librespot\librespot.exe" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
