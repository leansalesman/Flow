<Project>
  <!-- Keep bin/obj out of the OneDrive-synced folder to avoid sync file locks during builds. -->
  <PropertyGroup>
    <FlowBuildRoot>$(LOCALAPPDATA)\FlowBuild\$(MSBuildProjectName)\</FlowBuildRoot>
    <BaseIntermediateOutputPath>$(FlowBuildRoot)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(FlowBuildRoot)bin\</BaseOutputPath>
  </PropertyGroup>
</Project>
